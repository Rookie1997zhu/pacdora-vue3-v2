{
    email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
    root * /srv
    encode zstd gzip
    log {
        output stdout
        format json
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        -Server
    }
    request_body {
        max_size 32MB
    }

    @backend path /api /api/* /admin /admin/* /static /static/*
    handle @backend {
        reverse_proxy backend:8000 {
            header_up -X-Tenant-Key
            header_up -X-Tenant-User-Id
            header_up -X-User-Id
            header_up X-Forwarded-Proto {scheme}
        }
    }
    @private path /media /media/*
    handle @private {
        respond 404
    }
    @bundles path /assets /assets/*
    handle @bundles {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @files path_regexp files \.[^/]+$
    handle @files {
        header Cache-Control "no-cache"
        file_server
    }
    handle {
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
