ARG PYTHON_IMAGE=python:3.12-slim-bookworm
ARG BLENDER_VERSION=4.2.5
# Local/dev can set SKIP_BLENDER=1 + RENDER_MOCK=true to avoid ~350MB Blender download.
ARG SKIP_BLENDER=0
FROM ${PYTHON_IMAGE}

ARG BLENDER_VERSION=4.2.5
ARG SKIP_BLENDER=0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=3200 \
    HOST=0.0.0.0 \
    BLENDER_BIN=/opt/blender/blender \
    RENDER_MOCK=false

WORKDIR /app

# Prefer host-cached archive (deploy/cache) — avoids slow in-container downloads.
COPY deploy/cache/blender-${BLENDER_VERSION}-linux-x64.tar.xz* /tmp/

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi; \
    apt-get update; \
    if [ "$SKIP_BLENDER" = "1" ]; then \
      apt-get install -y --no-install-recommends ca-certificates; \
    else \
      apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils \
        libx11-6 libxi6 libxxf86vm1 libxfixes3 libxrender1 libgl1 libxcb1 \
        libsm6 libice6 libxkbcommon0 libdbus-1-3; \
      ARCHIVE="/tmp/blender-${BLENDER_VERSION}-linux-x64.tar.xz"; \
      if [ ! -f "$ARCHIVE" ]; then \
        curl -fsSL "https://mirrors.aliyun.com/blender/release/Blender${BLENDER_VERSION%.*}/blender-${BLENDER_VERSION}-linux-x64.tar.xz" \
          -o "$ARCHIVE"; \
      fi; \
      mkdir -p /opt/blender; \
      tar -xJf "$ARCHIVE" -C /opt/blender --strip-components=1; \
      rm -f "$ARCHIVE"; \
      test -x /opt/blender/blender; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    pip install --no-cache-dir pillow

COPY services/render/ /app/

EXPOSE 3200
CMD ["python", "server.py"]
