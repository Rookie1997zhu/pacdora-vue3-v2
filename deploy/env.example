# Copy to deploy/.env — never commit real secrets.

# Local smoke: use http://localhost (disables auto-HTTPS). Production: example.com
SITE_ADDRESS=http://localhost
ACME_EMAIL=admin@example.com

DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://localhost

POSTGRES_DB=boxcraft
POSTGRES_USER=boxcraft
POSTGRES_PASSWORD=replace-db-password

REDIS_PASSWORD=replace-redis-password

APP_TAG=local
WEB_TAG=local

# Base images (override if Docker Hub pull fails / use a mirror)
NODE_IMAGE=node:22-alpine
CADDY_IMAGE=caddy:2-alpine
PYTHON_IMAGE=python:3.12-slim-bookworm
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine

EMAIL_BACKEND_MODE=disabled
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
# Live Gemini smoke example (never put real keys in this file):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash-image
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_PROVIDER=test requires AI_ALLOW_TEST_PROVIDER=true outside DEBUG
AI_ALLOW_TEST_PROVIDER=false
PAYMENT_MODE=manual_quote

# P8.1 compose-smoke media-acl (required; never commit real production passwords)
# Create once: docker compose ... exec backend python manage.py createsuperuser
# Or a dedicated smoke user with email/password below.
SMOKE_EMAIL=smoke@boxcraft.local
SMOKE_PASSWORD=SmokeTest123!
