<bind symbol = "orm1">
	<param ref="orm1_Uni"/>
</bind>
<bind symbol = "ChannelOpaciti2">
	<param ref="ChannelOpaciti2_Uni"/>
</bind>
<bind symbol = "BezierPoints">
	<param ref="BezierPoints_Uni"/>
</bind>
<bind symbol = "BezierProps">
	<param ref="BezierProps_Uni"/>
</bind>
<bind symbol = "vertexToDesignMatrix">
	<param ref="vertexToDesignMatrix_Uni"/>
</bind>
<bind symbol = "designToVertexMatrix">
	<param ref="designToVertexMatrix_Uni"/>
