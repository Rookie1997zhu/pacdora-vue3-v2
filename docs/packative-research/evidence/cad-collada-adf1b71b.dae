<profile_GLSL>
<code sid="VERTEX_SH">
#define maxBeziers 16
#define maxCreaseInfos 4
#define maxCurvedInfos 4
#define HasCylinderDeform 1
#define HasConeDeform 1
#define NEEDSTANYTEXCOORDS 0
#define NEEDSTOXVECTOR 0
#if NEEDSTOXVECTOR
#error not implemented yet - no reason was found to support it
#endif
#define PI 			3.14159265358979323846
#define PI_2 		1.57079632679489661923
#define _inout
#define OT_NONE 0.0
#define OT_CYLYNDER_DEFORM 1.0
#define OT_CURVED_CREASE_DEFORM 2.0
#define OT_CONE_DEFORM 3.0
#if maxCreaseInfos&gt;0
uniform vec2 BezierPoints[maxBeziers*4];
uniform vec3 BezierProps[maxBeziers];
#endif
#if HasCylinderDeform==1
uniform vec4 cylinderData;
#endif
#if HasConeDeform==1
uniform vec4 coneDesignPos;
uniform float coneBending;
#endif
#if maxCurvedInfos&gt;=0
uniform vec4 curvedData;
#endif
#if NEEDSTANYTEXCOORDS
uniform mat4 vertexToDesignMatrix;
#endif
#if NEEDSTOXVECTOR
uniform mat4 designToVertexMatrix;
#endif
uniform float opDeformType;
#if maxCreaseInfos&gt;=1
attribute vec4 crInfo0;
#endif
#if maxCreaseInfos&gt;=2
attribute vec4 crInfo1;
#endif
#if maxCreaseInfos&gt;=3
attribute vec4 crInfo2;
#endif
#if maxCreaseInfos&gt;=4
attribute vec4 crInfo3;
#endif
#if maxCreaseInfos&gt;4
#error &quot;unsupported number of crease infos&quot;
#endif
#if maxCurvedInfos&gt;=1
attribute vec2 curvedInfo0;
attribute vec3 curvedNormInfo0;
#endif
#if maxCurvedInfos&gt;=2
attribute vec2 curvedInfo1;
attribute vec3 curvedNormInfo1;
#endif
#if maxCurvedInfos&gt;=3
attribute vec2 curvedInfo2;
attribute vec3 curvedNormInfo2;
#endif
#if maxCurvedInfos&gt;=4
attribute vec2 curvedInfo3;
attribute vec3 curvedNormInfo3;
#endif
#if maxCurvedInfos&gt;=5
#error &quot;unsupported number of curved deformations&quot;
#endif
varying vec4 frag_position;
varying vec3 normalVector;
#if NEEDSTOXVECTOR
varying vec3 oxVector;
varying vec2 designPos;
#endif
struct VertLocalInfo {
	vec3  pos;
	vec3  norm;
#if NEEDSTOXVECTOR
	vec3  ox;
#endif
};
#if maxCreaseInfos&gt;0
bool creaseTransform(vec4 vertInfo, out vec4 posOffset, out vec4 Tex)
{
	posOffset = vec4(0.0);
	Tex = vec4(0.0);
	if (vertInfo.w &lt; 0.0)
		return false;
	int idxB = int(vertInfo.w);
	vec2 curCurvPoint0= BezierPoints[idxB*4];
	vec2 curCurvPoint1= BezierPoints[idxB*4+1];
	vec2 curCurvPoint2= BezierPoints[idxB*4+2];
	vec2 curCurvPoint3= BezierPoints[idxB*4+3];
	vec3 curCurvProps= BezierProps[idxB];
	float flVertexScalar = vertInfo.z;
	if (flVertexScalar &lt;= curCurvProps.x || flVertexScalar &gt; curCurvProps.y)
		return false;
	float t = (flVertexScalar - curCurvProps.x) / (curCurvProps.y - curCurvProps.x);
	vec4 T = vec4(-3.0*(1.0-t)*(1.0-t), 9.0*t*t-12.0*t+3.0, 6.0*t-9.0*t*t, 3.0*t*t);
	vec4 V = vec4( pow(1.0 - t, 3.0),
	              -T.x*t,
	              T.w*(1.0-t),
	              pow(t, 3.0)
	              );
	vec4 Mx = vec4(curCurvPoint0.x, curCurvPoint1.x, curCurvPoint2.x, curCurvPoint3.x);
	vec4 My = vec4(curCurvPoint0.y, curCurvPoint1.y, curCurvPoint2.y, curCurvPoint3.y);
	vec2 posOnBezier = vec2(dot(Mx, V), dot(My, V));
	vec2 posOriginInZone = (flVertexScalar - curCurvProps.x) * curCurvProps.z * vertInfo.xy;
	float ptFaceNormalZ=0.0;
	if ((vec4(position, 1.)).z&gt;0.0)
		ptFaceNormalZ=1.0;
	else
		ptFaceNormalZ=-1.0;
	posOffset.xyz = /* bezier */vec3(posOnBezier.x * vertInfo.xy - posOriginInZone, ptFaceNormalZ*posOnBezier.y);
	float corr = ((posOnBezier.x/curCurvPoint3.x) - flVertexScalar);
	Tex = (vec4(position, 1.)) + vec4(vertInfo.xy*(corr*curCurvProps.z), 0.0, 0.0);
	posOffset.w = t;
	return true;
}
#endif
#if HasCylinderDeform==1
void transformCylinder(inout VertLocalInfo rVert)
{
	float arcLength = dot((vec4(position, 1.)).xy, cylinderData.xy) - cylinderData.z;
	float alpha = arcLength * cylinderData.w;
	float a_sin = sin(alpha);
	float a_cos = cos(alpha);
	float negcos = 1.0-a_cos;
	mat3 bendMatr;
	{
		vec2 negcos_xy2 = cylinderData.xy*cylinderData.xy*negcos;
		vec2 xy_sin = cylinderData.xy*a_sin;
		float negcos_x_y = negcos*cylinderData.x*cylinderData.y;
		bendMatr = mat3(a_cos + negcos_xy2.y, -negcos_x_y          , xy_sin.x,
		                -negcos_x_y          , a_cos + negcos_xy2.x, xy_sin.y,
		                -xy_sin.x            , -xy_sin.y            , a_cos);
	}
	vec3 basePos;
	if ((alpha &lt; -0.03) || (alpha &gt; 0.03))
		basePos = vec3((vec4(position, 1.)).xy - cylinderData.xy*(arcLength-a_sin/cylinderData.w), negcos/cylinderData.w);
	else
		basePos = vec3((vec4(position, 1.)).xy, arcLength*arcLength*cylinderData.w/2.0);
	vec3 vPosOffset = vec3(rVert.pos.xy-(vec4(position, 1.)).xy, rVert.pos.z);
	rVert.pos = basePos+(bendMatr*vPosOffset);
	rVert.norm = bendMatr*rVert.norm;
#if NEEDSTOXVECTOR
	rVert.ox = bendMatr*rVert.ox;
#endif
}
#endif
#if HasConeDeform==1
float atan2(vec2 v)
{
	if (abs(v.y)&lt;=abs(v.x))
		return atan(v.y, v.x);
	else if (v.y &gt; 0.0)
		return PI_2 + atan(-v.x, v.y);
	else
		return atan(v.x, -v.y) - PI_2;
}
float atan2(float y, float x)
{
	if (abs(y)&lt;=abs(x))
		return atan(y, x);
	else if (y &gt; 0.0)
		return PI_2 + atan(-x, y);
	else
		return atan(x, -y) - PI_2;
}
void transformCone(inout VertLocalInfo rVert)
{
	vec2 vPt = (vec4(position, 1.)).xy - coneDesignPos.xy;
	if (dot(vPt, vPt) &lt; 0.000001)
	{
		float cr = cos(coneBending);
		vec3 vC = vec3(-coneDesignPos.zw*sin(coneBending), cr);
		rVert.norm = vC * 0.000001;
	#if NEEDSTOXVECTOR
		rVert.ox = rVert.ox * 0.000001;
	#endif
	}
	else
	{
		vPt = normalize(vPt);
		vec2 vPtCS = vec2(vPt.x*coneDesignPos.z + vPt.y*coneDesignPos.w, -vPt.x*coneDesignPos.w + vPt.y*coneDesignPos.z);
		mat3 rot_a = mat3
		(
			 vPtCS.x, -vPtCS.y, 0.0,
			+vPtCS.y,  vPtCS.x, 0.0,
			0.0     ,  0.0    , 1.0
		);
		mat3 rota2;
		{
			float cr = cos(coneBending);
			float a = atan2(vPtCS);
			float a2 = a/cr;
			vec3 vC = vec3(-coneDesignPos.zw*sin(coneBending), cr);
			float cosa = cos(a2);
			float cos1_a = (1.0-cosa);
			float sina = sin(a2);
			rota2 = mat3
			(
				cos1_a*vC.x*vC.x + cosa     , cos1_a*vC.y*vC.x + sina*vC.z, cos1_a*vC.z*vC.x - sina*vC.y,
				cos1_a*vC.x*vC.y - sina*vC.z, cos1_a*vC.y*vC.y + cosa     , cos1_a*vC.z*vC.y + sina*vC.x,
				cos1_a*vC.x*vC.z + sina*vC.y, cos1_a*vC.y*vC.z - sina*vC.x, cos1_a*vC.z*vC.z + cosa
			);
		}
		mat3 bend = rota2*rot_a;
		vec3 focusPt = vec3(coneDesignPos.xy, 0.0);
		rVert.pos = bend*(rVert.pos - focusPt)+focusPt;
		rVert.norm = bend*rVert.norm;
	#if NEEDSTOXVECTOR
		rVert.ox = bend*rVert.ox;
	#endif
	}
}
#endif
#if maxCurvedInfos&gt;=1
vec3 calcCurvedNormal(float displacement, vec2 info, vec3 normInfo)
{
	float alpha = normInfo.x;
	float weight = info.y;
	float lenght = normInfo.y;
	float flatFactor = float(lenght == 0.0);
	float sin_beta = displacement / sqrt(pow(weight * lenght, 2.0) + displacement * displacement + flatFactor);
	float cos_beta = sqrt(1.0 - sin_beta * sin_beta);
	vec3 norm1 = vec3(cos(alpha), 0.0, sin(alpha));
	vec3 norm2 = flatFactor * vec3(0.0, 1.0, 0.0) + (1.0 - flatFactor) * vec3(0.0, cos_beta, sin_beta);
	float gamma = normInfo.z;
	mat3 rotation = mat3
	(
		cos(gamma), -sin(gamma), 0.0,
		sin(gamma),  cos(gamma), 0.0,
		0.0       , 0.0        , 0.0
	);
	return rotation * cross(norm1, norm2);
}
float calcCurvedDisplacement(vec2 info, float angle)
{
	float offset = info.x;
	float alpha = angle / 2.0 * float(abs(angle - PI) &gt; 1.0E-8);
	float displacement = offset * tan(alpha);
	return displacement;
}
const float inf = 3.402823466e+38;
void transformCurved(inout VertLocalInfo rVert)
{
	float sumDisplacement;
	float maxDisplacement, minDisplacement;
	vec3 sumNormVector = rVert.norm;
	if (curvedData[0]!=0.0)
	{
		float displacement = calcCurvedDisplacement(curvedInfo0, curvedData[0]);
		maxDisplacement = max(displacement, 0.0);
		minDisplacement = min(displacement, 0.0);
		sumDisplacement = curvedInfo0.y * displacement;
		float weight = curvedInfo0.y * sin(curvedData[0]);
		if (weight != 0.0)
		{
			vec3 normal = calcCurvedNormal(curvedInfo0.y * displacement, curvedInfo0, curvedNormInfo0);
			sumNormVector += mix(rVert.norm, normal, weight);
		}
	}
	else
	{
		sumDisplacement = 0.0;
		maxDisplacement = minDisplacement = 0.0;
		sumNormVector = vec3(0.0);
	}
#if maxCurvedInfos&gt;=2
	if (curvedData[1]!=0.0)
	{
		float displacement = calcCurvedDisplacement(curvedInfo1, curvedData[1]);
		maxDisplacement = max(maxDisplacement, displacement);
		minDisplacement = min(minDisplacement, displacement);
		sumDisplacement += curvedInfo1.y * displacement;
		float weight = curvedInfo1.y * sin(curvedData[1]);
		if (weight != 0.0)
		{
			vec3 normal = calcCurvedNormal(curvedInfo1.y * displacement, curvedInfo1, curvedNormInfo1);
			sumNormVector += mix(rVert.norm, normal, weight);
		}
	}
#endif
#if maxCurvedInfos&gt;=3
	if (curvedData[2]!=0.0)
	{
		float displacement = calcCurvedDisplacement(curvedInfo2, curvedData[2]);
		maxDisplacement = max(maxDisplacement, displacement);
		minDisplacement = min(minDisplacement, displacement);
		sumDisplacement += curvedInfo2.y * displacement;
		float weight = curvedInfo2.y * sin(curvedData[2]);
		if (weight != 0.0)
		{
			vec3 normal = calcCurvedNormal(curvedInfo2.y * displacement, curvedInfo2, curvedNormInfo2);
			sumNormVector += mix(rVert.norm, normal, weight);
		}
	}
#endif
#if maxCurvedInfos&gt;=4
	if (curvedData[3]!=0.0)
	{
		float displacement = calcCurvedDisplacement(curvedInfo3, curvedData[3]);
		maxDisplacement = max(maxDisplacement, displacement);
		minDisplacement = min(minDisplacement, displacement);
		sumDisplacement += curvedInfo3.y * displacement;
		float weight = curvedInfo1.y * sin(curvedData[3]);
		if (weight != 0.0)
		{
			vec3 normal = calcCurvedNormal(curvedInfo3.y * displacement, curvedInfo3, curvedNormInfo3);
			sumNormVector += mix(rVert.norm, normal, weight);
		}
	}
#endif
	rVert.pos.z += clamp(sumDisplacement, minDisplacement, maxDisplacement);
	rVert.norm = normalize(rVert.norm + sumNormVector);
}
#endif
void main()
{
#if NEEDSTANYTEXCOORDS
	vec4 tPos;
#endif
	VertLocalInfo vert;
#if NEEDSTOXVECTOR
	vert.ox = designToVertexMatrix[0].xyz * (normal).z;
#endif
	vert.norm = normal;
#if maxCreaseInfos&gt;=1
	vec4 sumVertOffset = vec4(0.0), curVertOffset;
	vec4 sumTex = vec4(0.0), curTex;
#endif
{
#if maxCreaseInfos&gt;=1
	if (creaseTransform(crInfo0, /*out*/curVertOffset, /*out*/curTex))
	{
		sumVertOffset.xyz += curVertOffset.w*curVertOffset.xyz;
		sumTex += curVertOffset.w*curTex;
		sumVertOffset.w += curVertOffset.w;
	}
#endif
#if maxCreaseInfos&gt;=2
	if (creaseTransform(crInfo1, /*out*/curVertOffset, /*out*/curTex))
	{
		sumVertOffset.xyz += curVertOffset.w*curVertOffset.xyz;
		sumTex += curVertOffset.w*curTex;
		sumVertOffset.w += curVertOffset.w;
	}
#endif
#if maxCreaseInfos&gt;=3
	if (creaseTransform(crInfo2, /*out*/curVertOffset, /*out*/curTex))
	{
		sumVertOffset.xyz += curVertOffset.w*curVertOffset.xyz;
		sumTex += curVertOffset.w*curTex;
		sumVertOffset.w += curVertOffset.w;
	}
#endif
#if maxCreaseInfos&gt;=4
	if (creaseTransform(crInfo3, /*out*/curVertOffset, /*out*/curTex))
	{
		sumVertOffset.xyz += curVertOffset.w*curVertOffset.xyz;
		sumTex += curVertOffset.w*curTex;
		sumVertOffset.w += curVertOffset.w;
	}
#endif
}
#if maxCreaseInfos&gt;=1
	if (sumVertOffset.w &gt; 0.0)
	{
		vert.pos      = (vec4(position, 1.)).xyz + sumVertOffset.xyz/sumVertOffset.w;
#if NEEDSTANYTEXCOORDS
		tPos = vertexToDesignMatrix * (sumTex/sumVertOffset.w);
#endif
	}
	else
#endif
	{
		vert.pos      = (vec4(position, 1.)).xyz;
#if NEEDSTANYTEXCOORDS
		tPos = vertexToDesignMatrix * vec4(position, 1.);
#endif
	}
#if HasCylinderDeform==1 || HasConeDeform==1 || maxCurvedInfos&gt;=1
	if (opDeformType == OT_NONE)
	{}
#if HasCylinderDeform==1
	else if (opDeformType == OT_CYLYNDER_DEFORM)
		transformCylinder(_inout vert);
#endif
#if HasConeDeform==1
	else if (opDeformType == OT_CONE_DEFORM)
		transformCone(_inout vert);
#endif
#if maxCurvedInfos&gt;=1
	else if (opDeformType == OT_CURVED_CREASE_DEFORM)
		transformCurved(_inout vert);
#endif
#endif
mat4 ModelViewProjectionMatrix=projectionMatrix * modelViewMatrix;
mat3 NormalMatrix= normalMatrix;
mat4 ModelViewMatrix= modelViewMatrix;
	gl_Position   = ModelViewProjectionMatrix * vec4(vert.pos, 1.0);
	normalVector = NormalMatrix * vert.norm;
	frag_position     = ModelViewMatrix * vec4(vert.pos, 1.0);
#if NEEDSTOXVECTOR
	oxVector     = NormalMatrix * vert.ox;
	designPos    = tPos.xy;
	designPos.y *= (normal).z;
#endif
}

</code>
<code sid="FRAGMENT_SH">
#define USE_GAMMACORRECTION 1
#define ENVMAP_FORMAT ENVMAP_FORMAT_LDR
#define ENVMAP_LINEAR 0
#define FORTREEJS
uniform float fMasterOpacity;
uniform float fGammaFactor;
uniform vec4  albedo0;
uniform vec4  orm0;
varying vec4 frag_position;
varying vec3 normalVector;
#define ENVMAP_FORMAT_LDR  0
#define ENVMAP_FORMAT_SRGB 1
#define ENVMAP_FORMAT_RGBE 2
const float PI = 3.14159265359;
const float RECIPROCAL_PI = 0.3183098861837907;
const float MAXIMUM_SPECULAR_COEFFICIENT = 0.16;
const float DEFAULT_SPECULAR_COEFFICIENT = 0.04;
#define _in
#define _out
#define _inout
uniform vec3 ambientLightColor;
#if NUM_DIR_LIGHTS &gt; 0
struct DirectionalLight {
	vec3 direction;
	vec3 color;
};
uniform DirectionalLight directionalLights[ NUM_DIR_LIGHTS ];
#endif
#if NUM_POINT_LIGHTS &gt; 0
struct PointLight {
	vec3 position;
	vec3 color;
	float distance;
	float decay;
};
uniform PointLight pointLights[ NUM_POINT_LIGHTS ];
#endif
#if NUM_SPOT_LIGHTS &gt; 0
struct SpotLight {
	vec3 position;
	vec3 direction;
	vec3 color;
	float distance;
	float decay;
	float coneCos;
	float penumbraCos;
};
uniform SpotLight spotLights[ NUM_SPOT_LIGHTS ];
#endif
#if defined(USE_ENVMAP)
 uniform sampler2D EnvBRDFLUT;
# if !defined(FORTREEJS)
  uniform mat4 viewMatrix;
# endif
# if defined(ENVMAP_TYPE_CUBE_UV)
  uniform sampler2D envMap;
  uniform vec2 envMapPixelSize;
  uniform float envBaseLODSize;
# else
  uniform samplerCube  envMap;
# endif
 uniform int maxMipLevel;
 uniform vec2 envLightCoefs;
#endif
struct BaseMaterial {
	vec4  albedo;
	vec4  orm;
	vec3  normal;
};
struct GeometricContext {
	vec3 position;
	vec3 viewdir;
	vec3 normal;
	vec3 vOx;
};
struct IncidentLight {
	vec3 color;
	vec3 direction;
};
struct PBRSurface {
	vec3  specular;
	vec4  diffuse;
	vec4  orm;
	vec3  normal;
};
void BlendPBRMaterial(const in vec4 albedo, const in vec4 orm, inout BaseMaterial mat)
{
	mat.albedo.rgb=mix(albedo.rgb, mat.albedo.rgb, (1.0-albedo.a)*mat.albedo.a);
	mat.albedo.a = mix(mat.albedo.a, 1.0, albedo.a);
	mat.orm.rgb = mix(orm.rgb, mat.orm.rgb, (1.0-orm.a)*mat.orm.a);
	mat.orm.a   = mix(mat.orm.a  , 1.0    , orm.a);
}
void BlendPBRMaterialU(const in vec4 albedo, const in vec4 orm, const in float usage, inout BaseMaterial mat)
{
	mat.albedo.rgb=mix(albedo.rgb, mat.albedo.rgb, (1.0-albedo.a*usage)*mat.albedo.a);
	mat.albedo.a = mix(mat.albedo.a, 1.0, albedo.a*usage);
	mat.orm.rgb = mix(orm.rgb, mat.orm.rgb, (1.0-orm.a*usage)*mat.orm.a);
	mat.orm.a   = mix(mat.orm.a  , 1.0    , orm.a*usage);
}
void TransformToPBR(const in BaseMaterial mat, out PBRSurface pbr)
{
	pbr.orm = mat.orm;
	pbr.specular = mix(vec3(DEFAULT_SPECULAR_COEFFICIENT), mat.albedo.rgb, mat.orm[2]);
	pbr.diffuse = mat.albedo;
}
float clearcoatDHRApprox( const in float roughness, const in float dotNL ) {
	return DEFAULT_SPECULAR_COEFFICIENT + ( 1.0 - DEFAULT_SPECULAR_COEFFICIENT ) * ( pow( 1.0 - dotNL, 5.0 ) * pow( 1.0 - roughness, 2.0 ) );
}
float DistributionGGX(const in vec3 N, const in vec3 H, const in float roughness)
{
    float a = roughness*roughness;
    float a2 = a*a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH*NdotH;
    float nom   = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;
    return nom / denom;
}
float GeometrySchlickGGX(const in float NdotV, const in float roughness)
{
    float r = (roughness + 1.0);
    float k = (r*r) / 8.0;
    float nom   = NdotV;
    float denom = NdotV * (1.0 - k) + k;
    return nom / denom;
}
float GeometrySmith(const in vec3 N, const in vec3 V, const in vec3 L, const in float roughness)
{
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    float ggx2 = GeometrySchlickGGX(_in NdotV, _in roughness);
    float ggx1 = GeometrySchlickGGX(_in NdotL, _in roughness);
    return ggx1 * ggx2;
}
vec3 fresnelSchlick(const in float cosTheta, const in vec3 specular)
{
    return specular + (vec3(1.0) - specular) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}
vec3 fresnelSchlickRoughness(const in float cosTheta, const in vec3 specular, const in float roughness)
{
    return specular + max(vec3(1.0 - roughness) - specular, vec3(0.0)) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}
vec3 CalcDirectLightColor(const in IncidentLight light, const in vec3 viewdir, const in PBRSurface surface, const in float diffuseOpacity)
{
	vec3 H = normalize(viewdir + light.direction);
	float NDF = DistributionGGX(_in surface.normal, _in H, _in surface.orm[1]);
	float G   = GeometrySmith(_in surface.normal, _in viewdir, _in light.direction, _in surface.orm[1]);
	vec3 F    = fresnelSchlick(dot(H, viewdir), _in surface.specular);
	vec3 numerator    = NDF * G * F;
	float denominator = 4.0 * max(dot(surface.normal, viewdir), 0.0) * max(dot(surface.normal, light.direction), 0.0) + 0.0001;
	vec3 specular = numerator / denominator;
	vec3 kS = F;
	vec3 kD = (vec3(1.0) - kS)*(1.0 - surface.orm[2]);
	float NdotL = max(dot(surface.normal, light.direction), 0.0);
	return (kD * surface.diffuse.rgb * (diffuseOpacity * RECIPROCAL_PI) + specular) * light.color * NdotL;
}
vec3 CalcDirectLightColorCoated(const in IncidentLight light, const in vec3 viewdir, const in PBRSurface material, const in PBRSurface coating)
{
	vec3 matOutput = CalcDirectLightColor(_in light, _in viewdir, _in material, 1.0);
	if (coating.orm.a &gt; 0.0)
	{
		float ccDotNL = dot( coating.normal, light.direction );
		float clearcoatDHR = coating.orm.a * clearcoatDHRApprox( _in coating.orm[1], _in ccDotNL );
		vec3 coatOutput = CalcDirectLightColor(_in light, _in viewdir, _in coating, coating.diffuse.a);
		return coatOutput + matOutput * (1.0-clearcoatDHR) * (1.0-coating.diffuse.a);
	}
	else
		return matOutput;
}
vec3 GammaToLinearv3( in vec3 value, in float gammaFactor ) {
	return pow( value, vec3( gammaFactor ) );
}
vec4 GammaToLinearv4( in vec4 value, in float gammaFactor ) {
	return vec4( pow( value.rgb, vec3( gammaFactor ) ), value.a );
}
vec3 LinearToGammav3( in vec3 value, in float gammaFactor ) {
	return pow( value, vec3( 1.0 / gammaFactor ) );
}
vec4 LinearToGammav4( in vec4 value, in float gammaFactor ) {
	return vec4( pow( value.rgb, vec3( 1.0 / gammaFactor ) ), value.a );
}
vec3 sRGBToLinearv3( in vec3 value ) {
    return mix( pow( value * 0.9478672986 + vec3( 0.0521327014 ), vec3( 2.4 ) ), value * 0.0773993808, vec3( lessThanEqual( value, vec3( 0.04045 ) ) ) );
}
vec3 RGBEToLinearv3( in vec4 value ) {
    return value.rgb * exp2( value.a * 255.0 - 128.0 );
}
vec3 ReinhardToneMapping( in vec3 color, const in float flExposure ) {
	color *= flExposure;
	return clamp( color / ( vec3( 1.0 ) + color ), 0.0, 1.0 );
}
#if defined(ENVMAP_TYPE_CUBE_UV)
vec4 textureCubeUVLocal(in vec3 N)
{
	vec3 absN = abs(N);
	if (absN.z &gt;= absN.x)
	{
		if (absN.z &gt;= absN.y)
			return N.z &gt; 0.0
			        ? vec4(2.0,  N.x/N.z, 0.0, -N.y/N.z)
			        : vec4(0.0,  N.x/N.z, 0.0,  N.y/N.z);
		else
			return N.y &gt; 0.0
			        ? vec4(2.0, -N.x/N.y, 1.0, -N.z/N.y)
			        : vec4(0.0, -N.x/N.y, 1.0,  N.z/N.y);
	}
	else
	{
		if (absN.x &gt;= absN.y)
			return N.x&gt;0.0
			        ? vec4(1.0,  N.y/N.x, 1.0, -N.z/N.x)
			        : vec4(1.0, -N.z/N.x, 0.0,  N.y/N.x);
		else
			return N.y &gt; 0.0
			        ? vec4(2.0, -N.x/N.y, 1.0, -N.z/N.y)
			        : vec4(0.0, -N.x/N.y, 1.0,  N.z/N.y);
	}
}
vec2 textureCubeUVIntCoords(vec4 uvPos, in float mipInt, in float tileSize)
{
	vec2 uvPx = vec2((uvPos.x + uvPos.y*0.5+0.5)*tileSize + 1.0, (uvPos.z + uvPos.w*0.5+0.5)*tileSize + uvPos.z*2.0+1.0);
	if (mipInt &gt; 0.0)
	{
		uvPx.y += 4.0 + envBaseLODSize*2.0;
		uvPx.x += 2.0*(mipInt-1.0) + (envBaseLODSize - 2.0*tileSize)*3.0;
	}
	return uvPx/envMapPixelSize;
}
vec4 textureCubeUV(in sampler2D sampler, in vec3 N, in float mip)
{
	float mipBase = floor(mip);
	float mipF = mip - mipBase;
	float tileBaseSize = envBaseLODSize/pow(2.0, mipBase);
	vec4 uvPos = textureCubeUVLocal(N);
	vec4 color0 = texture2D(sampler, textureCubeUVIntCoords(uvPos, mipBase, tileBaseSize));
	if (mipF&gt;0.0)
	{
		vec4 color1 = texture2D(sampler, textureCubeUVIntCoords(uvPos, mipBase+1.0, tileBaseSize*0.5));
		return mix(color0, color1, mipF);
	}
	else
		return color0;
}
#endif
#if defined(ENVMAP_TYPE_CUBE_UV)
#define MyTextureCubeLod textureCubeUV
#elif defined(FORTREEJS)
#define MyTextureCubeLod textureCubeLodEXT
#else
#define MyTextureCubeLod textureCubeLod
#endif
#if ENVMAP_FORMAT==ENVMAP_FORMAT_SRGB
#  define envColorToLinear(clr) sRGBToLinearv3(clr.rgb)
#elif ENVMAP_FORMAT==ENVMAP_FORMAT_RGBE
#  define envColorToLinear(clr) RGBEToLinearv3(clr)
#else
#  if defined(USE_GAMMACORRECTION) &amp;&amp; (!defined(ENVMAP_LINEAR) || ENVMAP_LINEAR==0)
#    define envColorToLinear(clr) GammaToLinearv3(clr.rgb, fGammaFactor)
#  else
#    define envColorToLinear(clr) clr.rgb
#  endif
#endif
#if defined(USE_ENVMAP)
vec3 FetchIrradianceColor(const in vec3 R)
{
	return envColorToLinear(MyTextureCubeLod(envMap, (vec4(R, 0.0)*viewMatrix).xyz,  float(maxMipLevel))) * envLightCoefs[0];
}
#endif
#if defined(USE_ENVMAP)
vec2 FetchBRDF(const in vec3 N, const in vec3 V, const in float roughness)
{
	return texture2D(EnvBRDFLUT, vec2(max(dot(N, V), 0.0), roughness)).rg;
}
#endif
#if defined(USE_ENVMAP)
vec3 FetchReflectionColor(const in vec3 R, const in float roughness)
{
	return envColorToLinear(MyTextureCubeLod(envMap, (vec4(R, 0.0)*viewMatrix).xyz,  roughness * float(maxMipLevel-1))) * envLightCoefs[1];
}
#endif
vec4 MakedUVdXYByTexmatrix(const in vec4 texMat[2])
{
	float det = texMat[0].x*texMat[1].y - texMat[0].y*texMat[1].x;
	return vec4(texMat[0].xy * (det / abs(det)), texMat[1].xy);
}
const float DhDxyHeightPixelStep = 0.70710678118654752440084436210485;
vec2 EvalDhDxyHeight_r(in sampler2D sampler, const in float hScale, const in vec2 uv, const in vec2 texPixels, const in vec4 dUVdXY)
{
	vec2 uv_dx_px = dUVdXY.xy*texPixels;
	float l_dx_px = length(uv_dx_px)/DhDxyHeightPixelStep;
	uv_dx_px /= (texPixels*l_dx_px);
	vec2 uv_dy_px = dUVdXY.zw*texPixels;
	float l_dy_px = length(uv_dy_px)/DhDxyHeightPixelStep;
	uv_dy_px /= (texPixels*l_dy_px);
	float dHdX = texture2D(sampler, uv+uv_dx_px).r - texture2D(sampler, uv-uv_dx_px).r;
	float dHdY = texture2D(sampler, uv+uv_dy_px).r - texture2D(sampler, uv-uv_dy_px).r;
	return vec2(dHdX*hScale*l_dx_px, dHdY*hScale*l_dy_px)*0.5;
}
vec2 EvalDhDxyHeight_g(in sampler2D sampler, const in float hScale, const in vec2 uv, const in vec2 texPixels, const in vec4 dUVdXY)
{
	vec2 uv_dx_px = dUVdXY.xy*texPixels;
	float l_dx_px = length(uv_dx_px)/DhDxyHeightPixelStep;
	uv_dx_px /= (texPixels*l_dx_px);
	vec2 uv_dy_px = dUVdXY.zw*texPixels;
	float l_dy_px = length(uv_dy_px)/DhDxyHeightPixelStep;
	uv_dy_px /= (texPixels*l_dy_px);
	float dHdX = texture2D(sampler, uv+uv_dx_px).g - texture2D(sampler, uv-uv_dx_px).g;
	float dHdY = texture2D(sampler, uv+uv_dy_px).g - texture2D(sampler, uv-uv_dy_px).g;
	return vec2(dHdX*hScale*l_dx_px, dHdY*hScale*l_dy_px)*0.5;
}
vec2 EvalDhDxyHeight_b(in sampler2D sampler, const in float hScale, const in vec2 uv, const in vec2 texPixels, const in vec4 dUVdXY)
{
	vec2 uv_dx_px = dUVdXY.xy*texPixels;
	float l_dx_px = length(uv_dx_px)/DhDxyHeightPixelStep;
	uv_dx_px /= (texPixels*l_dx_px);
	vec2 uv_dy_px = dUVdXY.zw*texPixels;
	float l_dy_px = length(uv_dy_px)/DhDxyHeightPixelStep;
	uv_dy_px /= (texPixels*l_dy_px);
	float dHdX = texture2D(sampler, uv+uv_dx_px).b - texture2D(sampler, uv-uv_dx_px).b;
	float dHdY = texture2D(sampler, uv+uv_dy_px).b - texture2D(sampler, uv-uv_dy_px).b;
	return vec2(dHdX*hScale*l_dx_px, dHdY*hScale*l_dy_px)*0.5;
}
vec2 EvalDhDxyHeight_a(in sampler2D sampler, const in float hScale, const in vec2 uv, const in vec2 texPixels, const in vec4 dUVdXY)
{
	vec2 uv_dx_px = dUVdXY.xy*texPixels;
	float l_dx_px = length(uv_dx_px)/DhDxyHeightPixelStep;
	uv_dx_px /= (texPixels*l_dx_px);
	vec2 uv_dy_px = dUVdXY.zw*texPixels;
	float l_dy_px = length(uv_dy_px)/DhDxyHeightPixelStep;
	uv_dy_px /= (texPixels*l_dy_px);
	float dHdX = texture2D(sampler, uv+uv_dx_px).a - texture2D(sampler, uv-uv_dx_px).a;
	float dHdY = texture2D(sampler, uv+uv_dy_px).a - texture2D(sampler, uv-uv_dy_px).a;
	return vec2(dHdX*hScale*l_dx_px, dHdY*hScale*l_dy_px)*0.5;
}
vec3 NormalFromHeightMapDhDxy(in vec2 dhDxy)
{
	return vec3(-dhDxy.x, -dhDxy.y, 1.0);
}
vec3 NormalFromHeightMapDhDxy2(in vec2 dhDxy1, in vec2 dhDxy2)
{
	return vec3(-(dhDxy1.x+dhDxy2.x), -(dhDxy1.y+dhDxy2.y), 1.0);
}
vec3 NormalFromHeightMap_r(in sampler2D sampler, const in float hScale, const in vec2 uv, const in vec2 texPixels, const in vec4 dUVdXY)
{
	return NormalFromHeightMapDhDxy(EvalDhDxyHeight_r(sampler, hScale, _in uv, _in texPixels, dUVdXY));
}
vec3 NormalFromHeightMap_g(in sampler2D sampler, const in float hScale, const in vec2 uv, const in vec2 texPixels, const in vec4 dUVdXY)
{
	return NormalFromHeightMapDhDxy(EvalDhDxyHeight_g(sampler, hScale, _in uv, _in texPixels, dUVdXY));
}
vec3 NormalFromHeightMap_b(in sampler2D sampler, const in float hScale, const in vec2 uv, const in vec2 texPixels, const in vec4 dUVdXY)
{
	return NormalFromHeightMapDhDxy(EvalDhDxyHeight_b(sampler, hScale, _in uv, _in texPixels, dUVdXY));
}
vec3 NormalFromHeightMap_a(in sampler2D sampler, const in float hScale, const in vec2 uv, const in vec2 texPixels, const in vec4 dUVdXY)
{
	return NormalFromHeightMapDhDxy(EvalDhDxyHeight_a(sampler, hScale, _in uv, _in texPixels, dUVdXY));
}
vec3 CalcEnvMapLightColor(const in vec3 viewdir, const in PBRSurface surface, const in float  diffuseOpacity)
{
	vec3 kS = fresnelSchlickRoughness(dot(surface.normal, viewdir), _in surface.specular, surface.orm[1]);
	vec3 kD = (vec3(1.0) - kS)*(1.0 - surface.orm[2]);
#if defined(USE_ENVMAP)
	vec2 brdf  = FetchBRDF(_in surface.normal, _in viewdir, _in surface.orm[1]);
	vec3 diffuse = kD * surface.diffuse.rgb * diffuseOpacity * (FetchIrradianceColor(_in surface.normal) + ambientLightColor);
	vec3 prefilteredColor = FetchReflectionColor(reflect(-viewdir, surface.normal),  surface.orm[1]);
	vec3 specular = prefilteredColor * (kS * brdf.x + brdf.y);
#else
	vec3 diffuse = kD * surface.diffuse.rgb * diffuseOpacity * ambientLightColor;
	vec3 specular = vec3(0.0, 0.0, 0.0);
#endif
	return diffuse * surface.orm[0]  + specular;
}
vec3 CalcEnvMapLightColorCoated(const in vec3 viewdir, const in PBRSurface surface, const in PBRSurface coating)
{
	vec3 matOutput = CalcEnvMapLightColor(_in viewdir, _in surface, 1.0);
	if (coating.orm.a &gt; 0.0)
	{
		float ccDotNV = dot( coating.normal, viewdir );
		float clearcoatDHR = coating.orm.a * clearcoatDHRApprox( _in coating.orm[1], _in ccDotNV );
		vec3 coatOutput = CalcEnvMapLightColor(_in viewdir, _in coating, coating.diffuse.a);
		return coatOutput + matOutput * (1.0-clearcoatDHR) * (1.0-coating.diffuse.a);
	}
	else
		return matOutput;
}
float punctualLightIntensityToIrradianceFactor( const in float lightDistance, const in float cutoffDistance, const in float decayExponent )
{
#if defined ( PHYSICALLY_CORRECT_LIGHTS )
	float distanceFalloff = 1.0 / max( pow( lightDistance, decayExponent ), 0.01 );
	if( cutoffDistance &gt; 0.0 ) {
		distanceFalloff *= pow2( saturate( 1.0 - pow4( lightDistance / cutoffDistance ) ) );
	}
	return distanceFalloff;
#else
	if( cutoffDistance &gt; 0.0 &amp;&amp; decayExponent &gt; 0.0 )
		return pow( clamp(  1.0 - lightDistance / cutoffDistance, 0.0, 1.0 ), decayExponent );
	else
		return 1.0;
#endif
}
#if NUM_POINT_LIGHTS &gt; 0
bool getPointDirectLightIrradiance( const in PointLight pointLight, const in vec3 fargPos, out IncidentLight directLight ) {
	vec3 lVector = pointLight.position - fargPos;
	directLight.direction = normalize( lVector );
	float irradFactor = punctualLightIntensityToIrradianceFactor( length( lVector ), pointLight.distance, pointLight.decay );
		directLight.color = pointLight.color * irradFactor;
	return irradFactor&gt;0.0;
}
#endif
#if NUM_SPOT_LIGHTS &gt; 0
bool getSpotDirectLightIrradiance( const in SpotLight spotLight, const in vec3 fargPos, out IncidentLight directLight  ) {
	vec3 lVector = spotLight.position - fargPos;
	directLight.direction = normalize( lVector );
	float angleCos = dot( directLight.direction, spotLight.direction );
	if ( angleCos &gt; spotLight.coneCos ) {
		float spotEffect = smoothstep( spotLight.coneCos, spotLight.penumbraCos, angleCos );
		float irradFactor = punctualLightIntensityToIrradianceFactor( length( lVector ), spotLight.distance, spotLight.decay );
		float totalFactor = (spotEffect * irradFactor);
		directLight.color = spotLight.color * totalFactor;
		return totalFactor&gt;0.0;
	} else {
		directLight.color = vec3( 0.0 );
		return false;
	}
}
#endif
#ifdef CLEARCOAT
vec3 CalcOutputColor(const in vec3 position, const in vec3 viewdir, const in PBRSurface surface, const in PBRSurface coating)
{
	vec3 sum = vec3(0.0);
#if NUM_DIR_LIGHTS &gt; 0
	for (int iDirLight = 0; iDirLight &lt; NUM_DIR_LIGHTS; ++iDirLight)
	{
		IncidentLight light;
		light.direction = normalize(_in directionalLights[iDirLight].direction);
		light.color = directionalLights[iDirLight].color;
		sum += CalcDirectLightColorCoated(_in light, _in viewdir, _in surface, _in coating);
	}
#endif
#if NUM_POINT_LIGHTS &gt; 0
	for (int ipointLight = 0; ipointLight &lt; NUM_POINT_LIGHTS; ++ipointLight)
	{
		IncidentLight light;
		if (getPointDirectLightIrradiance(_in  pointLights[ipointLight], _in  position, _out light))
			sum += CalcDirectLightColorCoated(_in light, _in viewdir, _in surface, _in coating);
	}
#endif
#if NUM_SPOT_LIGHTS &gt; 0
	for (int iSpotLight = 0; iSpotLight &lt; NUM_SPOT_LIGHTS; ++iSpotLight)
	{
		IncidentLight light;
		if (getSpotDirectLightIrradiance(_in  spotLights[iSpotLight], _in  position, _out light))
			sum += CalcDirectLightColorCoated(_in light, _in viewdir, _in surface, _in coating);
	}
#endif
	sum += CalcEnvMapLightColorCoated(_in viewdir, _in surface, _in coating);
	return sum;
}
#else
vec3 CalcOutputColor(const in vec3 position, const in vec3 viewdir, const in PBRSurface surface)
{
	vec3 sum = vec3(0.0);
#if NUM_DIR_LIGHTS &gt; 0
	for (int iDirLight = 0; iDirLight &lt; NUM_DIR_LIGHTS; ++iDirLight)
	{
		IncidentLight light;
		light.direction = normalize(directionalLights[iDirLight].direction);
		light.color = directionalLights[iDirLight].color;
		sum += CalcDirectLightColor(_in light, _in viewdir, _in surface, 1.0);
	}
#endif
#if NUM_POINT_LIGHTS &gt; 0
	for (int ipointLight = 0; ipointLight &lt; NUM_POINT_LIGHTS; ++ipointLight)
	{
		IncidentLight light;
		if (getPointDirectLightIrradiance(_in pointLights[ipointLight], _in position, _out light))
			sum += CalcDirectLightColor(_in light, _in viewdir, _in surface, 1.0);
	}
#endif
#if NUM_SPOT_LIGHTS &gt; 0
	for (int iSpotLight = 0; iSpotLight &lt; NUM_SPOT_LIGHTS; ++iSpotLight)
	{
		IncidentLight light;
		if (getSpotDirectLightIrradiance(_in  spotLights[iSpotLight], _in  position, _out light))
			sum += CalcDirectLightColor(_in light, _in viewdir, _in surface, 1.0);
	}
#endif
	sum += CalcEnvMapLightColor(_in viewdir, _in surface, 1.0);
	return sum;
}
#endif
void main()
{
	GeometricContext geometry;
	geometry.position=frag_position.xyz;
	geometry.viewdir = normalize(-frag_position.xyz);
	geometry.normal = normalize(normalVector);
	BaseMaterial material;
	{
		material.normal = vec3(0.0, 0.0, 1.0);
		material.albedo=GammaToLinearv4(albedo0, fGammaFactor);
		material.orm=orm0;
	}
	PBRSurface pbrMaterial;
	TransformToPBR(_in material, _out pbrMaterial);
	pbrMaterial.normal = geometry.normal;
	vec3 outColor = CalcOutputColor(geometry.position, geometry.viewdir, pbrMaterial);
	outColor = LinearToGammav3(outColor, fGammaFactor);
	gl_FragColor = vec4(outColor, material.albedo.a*fMasterOpacity);
}

